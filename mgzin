--// DRAG PANEL

local dragging = false
local dragStart
local startPosition

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType ==
        Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

--// SHADER SYSTEM

local function removeShader()
    for _, effect in ipairs(shaderEffects) do
        if effect and effect.Parent then
            effect:Destroy()
        end
    end

    table.clear(shaderEffects)
end

local function setShader(enabled)
    shaderEnabled = enabled
    removeShader()

    if enabled then
        local atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "MGZINN_Atmosphere"
        atmosphere.Density = 0.25
        atmosphere.Offset = 0.15
        atmosphere.Color = Color3.fromRGB(205, 220, 255)
        atmosphere.Decay = Color3.fromRGB(100, 120, 155)
        atmosphere.Glare = 0.3
        atmosphere.Haze = 1
        atmosphere.Parent = Lighting
        table.insert(shaderEffects, atmosphere)

        local bloom = Instance.new("BloomEffect")
        bloom.Name = "MGZINN_Bloom"
        bloom.Intensity = 0.35
        bloom.Size = 28
        bloom.Threshold = 1.1
        bloom.Parent = Lighting
        table.insert(shaderEffects, bloom)

        local color = Instance.new("ColorCorrectionEffect")
        color.Name = "MGZINN_Color"
        color.Brightness = 0.04
        color.Contrast = 0.16
        color.Saturation = 0.2
        color.TintColor = Color3.fromRGB(255, 248, 238)
        color.Parent = Lighting
        table.insert(shaderEffects, color)

        local rays = Instance.new("SunRaysEffect")
        rays.Name = "MGZINN_SunRays"
        rays.Intensity = 0.12
        rays.Spread = 0.8
        rays.Parent = Lighting
        table.insert(shaderEffects, rays)

        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = true
        Lighting.ExposureCompensation = 0.15
        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
    else
        for property, value in pairs(originalLighting) do
            Lighting[property] = value
        end
    end

    shaderButton.Text = enabled and
        "SHADER: ON" or "SHADER: OFF"

    status.Text = enabled and
        "MGZINN SHADER ACTIVATED" or "SHADER DISABLED"
end

--// CLEAN SCREEN SYSTEM

local coreTypes = {
    Enum.CoreGuiType.Backpack,
    Enum.CoreGuiType.Chat,
    Enum.CoreGuiType.EmotesMenu,
    Enum.CoreGuiType.Health,
    Enum.CoreGuiType.PlayerList,
}

local function setClean(enabled)
    cleanEnabled = enabled

    if enabled then
        table.clear(originalGuiStates)
        table.clear(originalCoreStates)

        for _, item in ipairs(playerGui:GetChildren()) do
            if item:IsA("ScreenGui") and item ~= gui then
                originalGuiStates[item] = item.Enabled
                item.Enabled = false
            end
        end

        for _, coreType in ipairs(coreTypes) do
            pcall(function()
                originalCoreStates[coreType] =
                    StarterGui:GetCoreGuiEnabled(coreType)

                StarterGui:SetCoreGuiEnabled(coreType, false)
            end)
        end
    else
        for item, previousState in pairs(originalGuiStates) do
            if item and item.Parent then
                item.Enabled = previousState
            end
        end

        for coreType, previousState in pairs(originalCoreStates) do
            pcall(function()
                StarterGui:SetCoreGuiEnabled(
                    coreType,
                    previousState
                )
            end)
        end

        table.clear(originalGuiStates)
        table.clear(originalCoreStates)
    end

    cleanButton.Text = enabled and
        "CLEAN SCREEN: ON" or "CLEAN SCREEN: OFF"

    status.Text = enabled and
        "CLEAN SCREEN ACTIVATED" or "INTERFACE RESTORED"
end

--// RENDER BOOST

local function setRender(enabled)
    renderEnabled = enabled

    if enabled then
        originalQuality = UserGameSettings.SavedQualityLevel

        pcall(function()
            UserGameSettings.SavedQualityLevel =
                Enum.SavedQualitySetting.QualityLevel1
        end)

        Lighting.GlobalShadows = false

        table.clear(originalEffectStates)

        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                originalEffectStates[effect] = effect.Enabled
                effect.Enabled = false
            end
        end
    else
        pcall(function()
            UserGameSettings.SavedQualityLevel = originalQuality
        end)

        Lighting.GlobalShadows =
            originalLighting.GlobalShadows

        for effect, previousState in pairs(originalEffectStates) do
            if effect and effect.Parent then
                effect.Enabled = previousState
            end
        end

        table.clear(originalEffectStates)
    end

    renderButton.Text = enabled and
        "RENDER BOOST: ON" or "RENDER BOOST: OFF"

    status.Text = enabled and
        "MGZINN PERFORMANCE MODE" or "GRAPHICS RESTORED"
end

--// RESET SYSTEM

local function resetAll()
    if shaderEnabled then
        setShader(false)
    end

    if cleanEnabled then
        setClean(false)
    end

    if renderEnabled then
        setRender(false)
    end

    for property, value in pairs(originalLighting) do
        pcall(function()
            Lighting[property] = value
        end)
    end

    status.Text = "MGZINN SETTINGS RESTORED"
end

